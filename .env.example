DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-flash
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_DEVICE=auto
DATA_DIR=data/documents
MILVUS_URI=http://localhost:19531
COLLECTION_NAME=research_docs
ADDITIONS_COLLECTION_NAME=research_docs_additions
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
RAG_RELEVANCE_THRESHOLD=0.55
CONVERSATION_DIR=data/conversations
# 仅限制发送给模型的最近轮数，数据库保留完整历史。
CHAT_CONTEXT_TURNS=20
MAX_TOOL_CALLS=6
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
# 第四周候选未通过默认采用门槛，保留原检索和模型追问；仅在独立验证时开启候选。
GROUNDED_ANSWERS=false
FOLLOWUP_MODE=model
# 本地最小诊断仅记录阶段、耗时、状态和用量，不记录正文或凭据。
TELEMETRY_ENABLED=true
