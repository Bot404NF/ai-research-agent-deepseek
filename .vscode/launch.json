{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动 Research Agent 网页",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "research_agent.cli",
      "args": ["web"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONUNBUFFERED": "1"
      },
      "console": "internalConsole",
      "justMyCode": true
    }
  ]
}
